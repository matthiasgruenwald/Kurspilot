# Plugin-Deploy-Parameter (Template) — echte Overrides in .env.plugin-deploy (gitignored)
#
# Das Deploy-Skript scripts/deploy-plugin.sh liest aktuell keine .env-Datei;
# die Werte unten sind dort fest konfiguriert (Single Source of Truth).
# Diese Datei dient als Referenz und Basis, falls Deploy-Automatisierung die
# Parameter spaeter aus der Umgebung lesen soll.
#
# Moodle-Credentials fuer Verifizierung nach dem Deploy: siehe .env.e2e.
# Workflow-Doku: docs/plugin-deploy.md

DEPLOY_HOST=1.2.3.31
DEPLOY_USER=moodle-deploy
DEPLOY_SSH_KEY=~/.ssh/id_moodle_deploy
DEPLOY_TARGET_DIR=/opt/moodle/local/coursepilot
MOODLE_CONTAINER=moodle-docker-webserver-1
